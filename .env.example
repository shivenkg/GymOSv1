# =====================================================================
# GymOS Environment Configuration
# =====================================================================

# Server Port
PORT=3000
NODE_ENV=development

# MongoDB Connection Configuration (Atlas Cluster or local)
# Format: mongodb+srv://[user]:[password]@[host]/[database]?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://superadmin:Admin%23321@cluster0.ln8epjv.mongodb.net/gymos?retryWrites=true&w=majority&appName=Cluster0

# PostgreSQL Connection Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://gymos_user:secure_password_here@localhost:5432/gymos_db

# DB Pool Tuning
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# Authentication & Session Security (Strong random secret for signing HS256 JWT tokens)
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_char_string_here

# Frontend Client Configuration (Vite)
VITE_API_URL=/api

# (Optional) Cloud AI Assistant Integrations (if enabled)
# GEMINI_API_KEY=your_optional_gemini_api_key_here
